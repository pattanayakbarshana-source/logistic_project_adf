{
	"name": "PL_data_ingestion",
	"properties": {
		"activities": [
			{
				"name": "Lookup_ingestion_configuration_table_source",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT source_name FROM metadata.ingestion_configuration WHERE \nis_run = 1;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_ingestion_config_table",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "For Each Record",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_ingestion_configuration_table_source",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_ingestion_configuration_table_source').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Switch_resources",
							"type": "Switch",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"on": {
									"value": "@item().source_name",
									"type": "Expression"
								},
								"cases": [
									{
										"value": "adls",
										"activities": [
											{
												"name": "Execute PL_copy_from_adls",
												"type": "ExecutePipeline",
												"dependsOn": [],
												"policy": {
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"pipeline": {
														"referenceName": "PL_copy_from_adls",
														"type": "PipelineReference"
													},
													"waitOnCompletion": true
												}
											},
											{
												"name": "adls_wait",
												"type": "Wait",
												"dependsOn": [],
												"userProperties": [],
												"typeProperties": {
													"waitTimeInSeconds": 5
												}
											}
										]
									},
									{
										"value": "sql_db",
										"activities": [
											{
												"name": "PL_copy_from_AzureSQL",
												"type": "ExecutePipeline",
												"dependsOn": [],
												"policy": {
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"pipeline": {
														"referenceName": "PL_copy_from_azureSQL",
														"type": "PipelineReference"
													},
													"waitOnCompletion": true
												}
											},
											{
												"name": "sql wait",
												"type": "Wait",
												"dependsOn": [],
												"userProperties": [],
												"typeProperties": {
													"waitTimeInSeconds": 5
												}
											}
										]
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"is_full_load": {
				"type": "string"
			}
		},
		"variables": {
			"container_name": {
				"type": "String"
			},
			"source path": {
				"type": "String"
			},
			"target container name": {
				"type": "String"
			},
			"sink target path": {
				"type": "String"
			}
		},
		"annotations": []
	}
}